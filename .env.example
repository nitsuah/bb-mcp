# Blackboard Learn MCP Server environment
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ── Blackboard Learn OAuth 2.0 ──────────────────────────────────────────────
# Application credentials from developer.blackboard.com
BB_CLIENT_ID=your_client_id_here
BB_CLIENT_SECRET=your_client_secret_here

# Base URL of your Blackboard Learn instance (or the sandbox)
# Sandbox: https://developer.blackboard.com/portal/displayApi
BB_BASE_URL=https://your-instance.blackboard.com

# Optional: Authorization Code flow configuration.
# If BB_OAUTH_REDIRECT_URI is not set, bb-mcp derives it from PUBLIC_BASE_URL + /oauth/callback.
BB_OAUTH_REDIRECT_URI=
BB_OAUTH_SCOPE=
BB_OAUTH_AUTHORIZATION_PATH=/learn/api/public/v1/oauth2/authorizationcode
BB_OAUTH_TOKEN_PATH=/learn/api/public/v1/oauth2/token

# ── Server ───────────────────────────────────────────────────────────────────
PORT=3100
# Defaults to all interfaces (0.0.0.0) so `docker compose`'s `-p 3100:3100`
# port publishing keeps working unmodified. Non-loopback deployments must
# configure OIDC_ISSUER, OIDC_AUDIENCE and OIDC_JWKS_URI; a shared API key alone
# cannot establish the end-user identity. Loopback-only local deployments may
# continue using the legacy local-client identity contract.
HOST=0.0.0.0
LOG_LEVEL=info
PUBLIC_BASE_URL=http://localhost:3100

# Optional second-factor shared secret. Non-loopback deployments require OIDC
# issuer/audience/JWKS validation regardless of this key. With OIDC enabled,
# send this key in X-MCP-API-Key because Authorization: Bearer carries the
# end-user access token. Without OIDC, the key is supported only on loopback.
MCP_API_KEY=

# On a non-loopback HOST, direct HTTPS is required; OIDC bearer tokens must
# never traverse plain HTTP. TRUST_PROXY_TLS=true instead forces a loopback
# bind so only the co-located TLS-terminating proxy can reach this listener.
TLS_CERT_PATH=
TLS_KEY_PATH=

# Alternative to TLS_CERT_PATH/TLS_KEY_PATH: set to true only when a
# trusted TLS-terminating reverse proxy (nginx, Traefik, Caddy, etc.)
# shares this process's network namespace. This OVERRIDES HOST above and
# forces an actual loopback bind — a configured HOST would otherwise
# remain a second, unprotected path straight to this plain-HTTP listener.
# Only a proxy in the same namespace (same container, Docker's
# network_mode: service:<name>, a Kubernetes sidecar, etc.) can then reach
# this server at all.
TRUST_PROXY_TLS=

# ── End-user identity (required for non-loopback deployments) ───────────────
# Configure all three values for a generic OIDC provider (Entra ID, Okta, etc.).
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URI=
OIDC_USER_ID_CLAIM=sub
OIDC_ROLE_CLAIM=role
OIDC_FERPA_CLAIM=ferpa_authorized
OIDC_ROLE_MAP=student=student,instructor=instructor,admin=admin,parent=parent
# disabled | optional | required | trusted-proxy
OIDC_MTLS_MODE=disabled

# ── Metrics ──────────────────────────────────────────────────────────────────
# Optional: Prometheus-compatible push gateway
METRICS_PUSH_URL=

# ── FERPA / Safety ──────────────────────────────────────────────────────────
# Comma-separated list of tool names that require elevated identity verification
# (caller_identity.ferpa_authorized=true), on top of the role check. Includes
# every tool that returns another person's PII: instructor at-risk/grade/
# submission views, and the admin directory/enrollment/audit-log surface.
RESTRICTED_TOOLS=get_at_risk_students,get_grade_distribution,get_submission_status,get_grades,list_users,get_user,list_enrollments,list_audit_logs

# Per-role request limits (auth layer) per rolling minute window
RATE_LIMIT_STUDENT_PER_MINUTE=60
RATE_LIMIT_INSTRUCTOR_PER_MINUTE=120
RATE_LIMIT_ADMIN_PER_MINUTE=180
